// Prisma schema for the movie / TV series catalog.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enums in Prisma, so these are strings with a fixed set
// of values:
//   platform:  "Netflix" | "Amazon Prime Video" | "Disney+" | "Cinema"
//   mediaType: "Movie" | "Series"
//   status:    "Watched" | "To watch"

model Title {
  id            Int       @id @default(autoincrement())
  title         String
  searchTitle   String // normalized form used for search and de-duplication
  platform      String
  mediaType     String
  status        String
  lastWatchedAt DateTime?
  // Series only: how many seasons exist (from TMDB) and how many have been
  // watched (derived from the imported history, editable by hand afterwards).
  totalSeasons   Int?
  watchedSeasons Int?
  inWatchlist    Boolean @default(false)
  link           String?

  // Enriched from TMDB
  tmdbId      Int?
  posterUrl   String?
  backdropUrl String?
  overview    String?
  tmdbRating  Float?
  year        Int?
  genres      String? // comma-separated list

  personalRating Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([platform])
  @@index([mediaType])
  @@index([status])
  @@index([searchTitle])
}

// Single row (id fixed to 1) holding configuration set through the first-run
// setup wizard instead of deploy-time environment variables: the TMDB content
// language/region, and — once configured — the TOTP secret that gates login.
//
// SESSION_SECRET stays an environment variable on purpose: it signs the
// session cookie, so keeping it out of the database it protects means a
// leaked database alone cannot be used to forge a valid session, only to
// read the catalog and the TOTP secret.
model Settings {
  id         Int      @id @default(1)
  language   String   @default("en-US")
  region     String   @default("US")
  totpSecret String?
  onboarded  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
