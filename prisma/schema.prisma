// Prisma schema for the movie / TV series catalog.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enums in Prisma, so these are strings with a fixed set
// of values:
//   platform:  "Netflix" | "Amazon Prime Video" | "Disney+" | "Cinema"
//   mediaType: "Movie" | "Series"
//   status:    "Watched" | "To watch"

model Title {
  id            Int       @id @default(autoincrement())
  title         String
  searchTitle   String // normalized form used for search and de-duplication
  platform      String
  mediaType     String
  status        String
  lastWatchedAt DateTime?
  // Series only: how many seasons exist (from TMDB) and how many have been
  // watched (derived from the imported history, editable by hand afterwards).
  totalSeasons   Int?
  watchedSeasons Int?
  // Set by the automatic season check (src/lib/season-check.ts) when TMDB's
  // season count comes back higher than totalSeasons above — cleared when
  // the badge it drives on the card is dismissed. Series only.
  newSeasonAvailable Boolean @default(false)
  inWatchlist        Boolean @default(false)
  link               String?

  // Enriched from TMDB
  tmdbId      Int?
  posterUrl   String?
  backdropUrl String?
  overview    String?
  tmdbRating  Float?
  year        Int?
  genres      String? // comma-separated list

  personalRating Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([platform])
  @@index([mediaType])
  @@index([status])
  @@index([searchTitle])
}

// Single row (id fixed to 1) holding configuration set through the first-run
// setup wizard instead of deploy-time environment variables: the TMDB content
// language/region, and — once configured — the TOTP secret that gates login.
//
// SESSION_SECRET stays an environment variable on purpose: it signs the
// session cookie, so keeping it out of the database it protects means a
// leaked database alone cannot be used to forge a valid session, only to
// read the catalog and the TOTP secret.
model Settings {
  id         Int      @id @default(1)
  language   String   @default("en-US")
  region     String   @default("US")
  totpSecret String?
  onboarded  Boolean  @default(false)
  // A simple mutex for the AI recommendations refresh (src/lib/
  // recommendations.ts): set to "now" while a generation is in flight, so
  // an automatic background refresh and a manual click never both call
  // Claude at once. A lock older than a few minutes is treated as abandoned.
  recommendationsLockedAt DateTime?
  // Same mutex shape as above, for the automatic "any new seasons out?"
  // sweep (src/lib/season-check.ts) — lastSeasonCheckAt gates how often it
  // runs at all, seasonCheckLockedAt keeps two triggers (a page load and an
  // add, say) from running it at once.
  lastSeasonCheckAt   DateTime?
  seasonCheckLockedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// Every AI-generated "what to watch next" batch, kept as a permanent
// history rather than overwritten — the app always reads the most recent
// row. A new row only ever appears through the automatic 5-day refresh (or
// an early manual one) in src/lib/recommendations.ts, gated by the lock
// above so refreshing never costs more than one Claude call at a time.
model Recommendation {
  id          Int      @id @default(autoincrement())
  titles      String // JSON array of enriched recommendation objects
  generatedAt DateTime @default(now())

  @@index([generatedAt])
}

// A recommendation the user said "not interested" to. Kept forever (not
// per-batch): read on every "which of the stored batch are still worth
// showing" check, and folded into the prompt on the next generation so
// Claude stops re-suggesting it. `key` is recommendationKey() from
// src/lib/recommendation-candidate.ts — a TMDB id when Claude's pick was
// confirmed against TMDB, the normalized title otherwise.
model DismissedRecommendation {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  title       String
  mediaType   String
  dismissedAt DateTime @default(now())
}
