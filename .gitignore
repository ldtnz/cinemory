# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real secrets never get committed, the template does
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local database
# dev.db holds your own catalog, so it is never committed. It is created by
# "npx prisma migrate deploy" (or pulled from Turso with "npm run db:sync")
# and used by the import/seed scripts and by local development.
/prisma/dev.db
/prisma/dev.db-journal
/prisma/dev.db-shm
/prisma/dev.db-wal

# service worker generated at build time by @serwist/next (see src/app/sw.ts)
/public/sw.js
/public/sw.js.map
/public/swe-worker-*.js
/public/swe-worker-*.js.map

# watch-history exports: they are your personal data, keep them out of git.
# The *.example.csv files are fake samples and stay tracked.
/prisma/seed-data/*.csv
!/prisma/seed-data/*.example.csv
