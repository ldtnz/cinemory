# Copy this file to .env and fill in the values.
#   cp .env.example .env
# .env is git-ignored — never commit real secrets.


# ── Authentication (required) ────────────────────────────────────────────────
# Cinemory is a single-user catalog protected by a 6-digit TOTP code from an
# authenticator app (1Password, Aegis, Google Authenticator, …). The TOTP
# secret itself is NOT set here: the first time you open the app it walks you
# through a setup wizard (content language/region, then a QR code to scan)
# and stores the secret in the database. Only the key that signs the session
# cookie is a deploy-time secret, kept out of the database on purpose — a
# leaked database alone should not be enough to forge a session.

# Random key used to sign the session cookie. Any long random string works:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out.
SESSION_SECRET=


# ── TMDB (required) ──────────────────────────────────────────────────────────
# Posters, ratings, genres, release years and season counts come from The Movie
# Database. An account is free: https://www.themoviedb.org/signup
# then Settings → API (https://www.themoviedb.org/settings/api).
#
# Set ONE of the two. If both are present the access token wins.
#   TMDB_ACCESS_TOKEN — the "API Read Access Token" (v4), sent as a Bearer header
#   TMDB_API_KEY      — the older "API Key" (v3), sent as a query parameter
TMDB_ACCESS_TOKEN=
# TMDB_API_KEY=

# The language TMDB answers in (posters, overviews, genre names) and the
# region used to guess a title's streaming platform are set from the app
# itself — the setup wizard on first run, and afterwards the settings page —
# not from an environment variable.


# ── Database ─────────────────────────────────────────────────────────────────
# Two supported setups — pick one.
#
# 1. Self-hosted (Docker or plain Node): a local SQLite file. This is the
#    default; leave the TURSO_* variables empty.
DATABASE_URL="file:./dev.db"
#
# 2. Serverless hosting (Vercel and friends): the filesystem is read-only, so
#    the database lives on Turso (hosted libSQL, same SQLite schema). Set both
#    variables below and DATABASE_URL is ignored at runtime.
#    Sign up at https://turso.tech, then:
#      turso db create cinemory
#      turso db show cinemory --url          # -> TURSO_DATABASE_URL
#      turso db tokens create cinemory       # -> TURSO_AUTH_TOKEN
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=
